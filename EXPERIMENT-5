-- ============================================================
-- 4. VIEW: DEPARTMENT SALARY SUMMARY
-- Shows headcount, total salary and average salary per department.
-- LEFT JOIN keeps departments even if they have no employees.
-- ============================================================

CREATE VIEW department_salary_summary AS
SELECT
    d.department_id,
    d.department_name,
    COUNT(e.employee_id) AS employee_count,
    COALESCE(SUM(e.salary), 0.00) AS total_salary,
    ROUND(AVG(e.salary), 2) AS average_salary
FROM department AS d
LEFT JOIN employee AS e
    ON d.department_id = e.department_id
GROUP BY d.department_id, d.department_name;

SELECT *
FROM department_salary_summary
ORDER BY department_id;

-- ============================================================
-- 5. VIEW: EMPLOYEE HIERARCHY
-- Shows employee information and the employee's manager name.
-- ============================================================

CREATE VIEW employee_hierarchy AS
SELECT
    e.employee_id,
    e.employee_name,
    e.department_id,
    e.manager_id,
    m.employee_name AS manager_name,
    e.salary
FROM employee AS e
LEFT JOIN employee AS m
    ON e.manager_id = m.employee_id;

SELECT *
FROM employee_hierarchy
ORDER BY employee_id;

-- ============================================================
-- 6. VIEW UPDATABILITY TEST
-- This is a simple single-table view, so it is updatable.
-- The UPDATE changes the underlying employee table as well.
-- The salary update is +5,000 for employee 102.
-- ============================================================

CREATE VIEW employee_basic AS
SELECT employee_id, employee_name, salary
FROM employee;

-- Check the original value before updating
SELECT employee_id, employee_name, salary
FROM employee_basic
WHERE employee_id = 102;

UPDATE employee_basic
SET salary = salary + 5000.00
WHERE employee_id = 102;

-- Verify the update through the view
SELECT employee_id, employee_name, salary
FROM employee_basic
WHERE employee_id = 102;

-- Verify that the underlying base table was updated
SELECT employee_id, employee_name, salary
FROM employee
WHERE employee_id = 102;

-- ============================================================
-- 7. RECURSIVE CTE: REPORTING CHAIN
-- Anchor: employees without a manager.
-- Recursive member: find each employee reporting to the prior row.
-- MySQL requires an explicit CAST to make reporting_path wide enough.
-- ============================================================

WITH RECURSIVE reporting_chain AS (
    -- Anchor member: top-level employees
    SELECT
        employee_id,
        employee_name,
        manager_id,
        0 AS level,
        CAST(employee_name AS CHAR(1000)) AS reporting_path
    FROM employee
    WHERE manager_id IS NULL

    UNION ALL

    -- Recursive member: direct reports of employees already found
    SELECT
        e.employee_id,
        e.employee_name,
        e.manager_id,
        rc.level + 1 AS level,
        CONCAT(rc.reporting_path, ' -> ', e.employee_name) AS reporting_path
    FROM employee AS e
    INNER JOIN reporting_chain AS rc
        ON e.manager_id = rc.employee_id
)
SELECT
    employee_id,
    employee_name,
    manager_id,
    level,
    reporting_path
FROM reporting_chain
ORDER BY reporting_path;

-- ============================================================
-- 8. OPTIONAL VALIDATION QUERIES
-- ============================================================

SELECT COUNT(*) AS department_count FROM department;
SELECT COUNT(*) AS employee_count FROM employee;

-- Expected: department_count = 3, employee_count = 7.
-- Employee 102's salary is 70,000 after the view update.
