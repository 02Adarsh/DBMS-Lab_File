-- ============================================================
-- DBMS EXPERIMENT NO. 3
-- Employee-Department-Project Database
-- ============================================================

-- Create and select the database
CREATE DATABASE IF NOT EXISTS enterprise_db;
USE enterprise_db;

-- Drop child tables first so the script can be executed again safely
DROP TABLE IF EXISTS Employee_Project;
DROP TABLE IF EXISTS Employee;
DROP TABLE IF EXISTS Project;
DROP TABLE IF EXISTS Department;

-- ============================================================
-- 1. CREATE TABLES (PRIMARY KEY, FOREIGN KEY, NOT NULL)
-- ============================================================

CREATE TABLE Department (
    dept_id INT PRIMARY KEY,
    dept_name VARCHAR(50) NOT NULL UNIQUE,
    location VARCHAR(50)
);

CREATE TABLE Project (
    project_id INT PRIMARY KEY,
    project_name VARCHAR(80) NOT NULL UNIQUE,
    budget DECIMAL(12,2) NOT NULL CHECK (budget >= 0)
);

CREATE TABLE Employee (
    emp_id INT PRIMARY KEY,
    emp_name VARCHAR(60) NOT NULL,
    dept_id INT NOT NULL,
    salary DECIMAL(10,2) NOT NULL CHECK (salary >= 0),
    hire_date DATE NOT NULL,
    CONSTRAINT fk_employee_department
        FOREIGN KEY (dept_id) REFERENCES Department(dept_id)
);

-- Bridge table: an employee can work on multiple projects,
-- and a project can have multiple employees.
CREATE TABLE Employee_Project (
    emp_id INT NOT NULL,
    project_id INT NOT NULL,
    hours_worked INT NOT NULL CHECK (hours_worked >= 0),
    PRIMARY KEY (emp_id, project_id),
    CONSTRAINT fk_ep_employee
        FOREIGN KEY (emp_id) REFERENCES Employee(emp_id),
    CONSTRAINT fk_ep_project
        FOREIGN KEY (project_id) REFERENCES Project(project_id)
);

