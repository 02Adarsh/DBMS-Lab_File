-- ============================================================
-- 6. SELECTION (WHERE)
-- Display employees hired from 2023 onward whose salary > 75,000.
-- ============================================================

SELECT emp_id, emp_name, salary, hire_date
FROM Employee
WHERE hire_date >= '2023-01-01'
  AND salary > 75000
ORDER BY hire_date ASC;

-- ============================================================
-- 7. PROJECTION
-- Display only employee name, salary, and department ID.
-- ============================================================

SELECT emp_name, salary, dept_id
FROM Employee
ORDER BY emp_name ASC;

-- ============================================================
-- 8. AGGREGATE FUNCTIONS + GROUP BY
-- COUNT, SUM, AVG, MIN, MAX for each department.
-- ============================================================

SELECT d.dept_id,
       d.dept_name,
       COUNT(e.emp_id) AS staff_count,
       SUM(e.salary) AS total_payroll,
       ROUND(AVG(e.salary), 2) AS average_salary,
       MIN(e.salary) AS lowest_salary,
       MAX(e.salary) AS highest_salary
FROM Department AS d
JOIN Employee AS e ON e.dept_id = d.dept_id
GROUP BY d.dept_id, d.dept_name
ORDER BY total_payroll DESC;

-- ============================================================
-- 9. HAVING
-- Show departments whose total payroll is greater than 430,000.
-- ============================================================

SELECT d.dept_name,
       COUNT(e.emp_id) AS staff_count,
       SUM(e.salary) AS total_payroll
FROM Department AS d
JOIN Employee AS e ON e.dept_id = d.dept_id
GROUP BY d.dept_id, d.dept_name
HAVING SUM(e.salary) > 430000
ORDER BY total_payroll DESC;

-- ============================================================
-- 10. CASE EXPRESSION
-- Categorize employees by salary.
-- ============================================================

SELECT emp_name,
       salary,
       CASE
           WHEN salary >= 90000 THEN 'Executive'
           WHEN salary >= 75000 THEN 'Professional'
           ELSE 'Associate'
       END AS salary_level
FROM Employee
ORDER BY salary DESC, emp_name ASC;

-- ============================================================
-- 11. PROJECT-WISE WORKLOAD (JOIN + GROUP BY + AGGREGATES)
-- LEFT JOIN ensures projects with no assignments would still appear.
-- ============================================================

SELECT p.project_id,
       p.project_name,
       COUNT(ep.emp_id) AS assigned_employees,
       COALESCE(SUM(ep.hours_worked), 0) AS total_hours,
       ROUND(AVG(ep.hours_worked), 2) AS average_hours
FROM Project AS p
LEFT JOIN Employee_Project AS ep ON ep.project_id = p.project_id
GROUP BY p.project_id, p.project_name
ORDER BY total_hours DESC, p.project_name ASC;

-- ============================================================
-- 12. EMPLOYEES WITH MORE THAN 120 HOURS ON THEIR PROJECT
-- ============================================================

SELECT e.emp_name,
       p.project_name,
       ep.hours_worked
FROM Employee AS e
JOIN Employee_Project AS ep ON ep.emp_id = e.emp_id
JOIN Project AS p ON p.project_id = ep.project_id
WHERE ep.hours_worked > 120
ORDER BY ep.hours_worked DESC, e.emp_name ASC;

-- ============================================================
-- 13. VERIFY RECORD COUNTS
-- Expected: 5 departments, 8 projects, 30 employees, 30 assignments.
-- ============================================================

SELECT 'Department' AS table_name, COUNT(*) AS record_count FROM Department
UNION ALL
SELECT 'Project', COUNT(*) FROM Project
UNION ALL
SELECT 'Employee', COUNT(*) FROM Employee
UNION ALL
SELECT 'Employee_Project', COUNT(*) FROM Employee_Project;

